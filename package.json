{
  "name": "services-marketplace-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "npm run validate:plan && npm run validate:static && npm run build && npm run generate:openapi:check && npm run generate:sdk:check && npm test",
    "clean": "tsc -b --clean",
    "dev": "npm run build && node apps/api/dist/main.js",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "generate:openapi:check": "node scripts/generate-openapi.mjs --check",
    "generate:sdk": "node scripts/generate-sdk.mjs",
    "generate:sdk:check": "node scripts/generate-sdk.mjs --check",
    "migrate:down": "node scripts/run-migrations.mjs down",
    "migrate:up": "node scripts/run-migrations.mjs up",
    "start": "node apps/api/dist/main.js",
    "test": "node --test tests/*.test.mjs",
    "validate:plan": "node scripts/validate-plan.mjs",
    "validate:static": "node scripts/check-static.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.7.3"
  }
}
